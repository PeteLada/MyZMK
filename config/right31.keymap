#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y
                &none   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H
                &none   &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N
                &none   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
                &kp SPACE &kp ENTER &kp BSPC &kp TAB  &kp ESC   &kp MINUS &kp EQUAL
            >;
        };
    };
};
